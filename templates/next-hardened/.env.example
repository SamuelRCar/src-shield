# ── Banco de dados ─────────────────────────────────────────────────────────
# Usuário de privilégio mínimo (NUNCA root/postgres — ver README §Banco).
# TLS obrigatório: manter sslmode=require (checklist item 4).
DATABASE_URL="postgresql://app_user:SUA_SENHA_AQUI@localhost:5432/app?sslmode=require"

# ── Auth.js ────────────────────────────────────────────────────────────────
# Gerar com: npx auth secret   (mínimo 32 caracteres)
AUTH_SECRET="GERAR_UM_SEGREDO_FORTE_AQUI_32+"

# ── @src/shield (CSRF de formulários próprios) ─────────────────────────────
CSRF_SECRET="GERAR_OUTRO_SEGREDO_FORTE_AQUI_32+"

# ── Sentry (ligado na Etapa 5 — ver README) ────────────────────────────────
SENTRY_DSN=""
